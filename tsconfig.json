{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "types": [
      "bun-types"
    ],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.GCjEc7/symbolic-http-dist/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.GCjEc7/symbolic-http-dist/dev/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.2qvLLV/symbolic-http-dist/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.2qvLLV/symbolic-http-dist/dev/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.4NHyb1/symbolic-http-dist/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.4NHyb1/symbolic-http-dist/dev/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.ka9TDs/symbolic-http-dist/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.ka9TDs/symbolic-http-dist/dev/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.OFjQa4/symbolic-http-dist/types/**/*.ts",
    "node_modules/.edocbr-postgres-foundation.OFjQa4/symbolic-http-dist/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "mini-services/realtime/test-client.ts"
  ]
}
