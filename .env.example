# Copie para um gerenciador de segredos/ambiente. Não use os exemplos em produção.
DATABASE_URL="file:../db/custom.db?connection_limit=1&socket_timeout=30"
DEFAULT_TENANT_SLUG="camara-mucuri-ba"
# Ative somente durante diagnóstico pontual; o worker consulta o banco periodicamente.
PRISMA_LOG_QUERIES="false"
# Gere um valor aleatório de pelo menos 32 bytes e compartilhe com o realtime.
REALTIME_AUTH_SECRET=""
# Desenvolvimento demonstrativo apenas: true habilita seleção de perfis fictícios.
LEGIS_DEMO_MODE="false"
# Opcional no mini-serviço realtime; padrão: db/custom.db relativo ao projeto.
REALTIME_DB_PATH=""
REALTIME_DATABASE_PROVIDER=""
# Opcional apenas com PostgreSQL: Redis Streams privado para fanout entre nós.
REALTIME_REDIS_URL=""
# Opcional no serviço de webhooks SQLite; padrão: db/custom.db relativo ao projeto.
WEBHOOKS_DB_PATH=""
WEBHOOKS_DATABASE_PROVIDER=""
# URL HTTP local de métricas do MediaMTX. Ex.: http://127.0.0.1:9998/metrics.
# Deixe vazio até configurar um serviço local autenticado/isolado.
MEDIA_METRICS_URL=""
# API de controle MediaMTX em loopback (ex.: http://127.0.0.1:9997).
MEDIA_CONTROL_URL=""
# Caminho absoluto para JSON privado (0600/0400) com destinos por tenant.
# Nunca inclua stream keys neste .env ou no repositório.
MEDIA_DESTINATIONS_FILE=""

# Volume persistente compartilhado entre instâncias para fotos e emblemas (caminho absoluto).
PARLIAMENTARIAN_IMAGES_ROOT=""

# Worker de confirmação de assinaturas. Configure HTTPS público e relay institucional.
PUBLIC_BASE_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""
# Health local do worker; exponha apenas no host, não na internet.
MAIL_WORKER_HEALTH_PORT="3006"
MAIL_WORKER_HEALTH_URL="http://127.0.0.1:3006/health"
# Em contêiner isolado, use 0.0.0.0 apenas na rede privada e sem publicar a porta.
MAIL_WORKER_HEALTH_HOST="127.0.0.1"
REALTIME_HEALTH_URL="http://localhost:3003/health"
WEBHOOKS_HEALTH_URL="http://localhost:3004/health"
# Porta opcional do scheduler SQLite para ensaios isolados (padrão 3005).
SCHEDULER_PORT="3005"
